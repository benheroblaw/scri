{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "scri",
	"patterns": [
		{
			"match": "CMT<.*.>",
			"name": "comment.block"
		},
		{
			"match": "CMT>.*",
			"name": "comment.line"
		},
		{
			"match": "RES>",
			"name": "keyword.reset"
		},
		{
			"match": "LBLU>",
			"name": "keyword.lightblue"
		},
		{
			"match": "LGRN>",
			"name": "keyword.lightgreen"
		},
		{
			"match": "PUR>",
			"name": "keyword.purple"
		},
		{
			"match": "GRN>",
			"name": "keyword.green"
		},
		{
			"match": "PNK>",
			"name": "keyword.pink"
		},
		{
			"match": "RED>",
			"name": "keyword.red"
		},
		{
			"match": "BLU>",
			"name": "keyword.blue"
		},
		{
			"match": "YLW>",
			"name": "keyword"
		},
		{
			"match": "LME>",
			"name": "keyword"
		},
		{
			"match": "LGRY>",
			"name": "keyword"
		},
		{
			"match": "GRY>",
			"name": "keyword"
		},
		{
			"match": "WHI>",
			"name": "keyword"
		},
		{
			"match": "DGRY>",
			"name": "keyword"
		},
		{
			"match": "CYN>",
			"name": "keyword"
		},
		{
			"match": "BLK>",
			"name": "keyword"
		},
		{
			"match": "BGWHI>",
			"name": "keyword"
		},
		{
			"match": "BGRED>",
			"name": "keyword"
		},
		{
			"match": "NOBR>",
			"name": "keyword"
		},
		{
			"match": "CLRA>",
			"name": "keyword"
		},
		{
			"match": "CLRB>",
			"name": "keyword"
		},
		{
			"match": "CONT>",
			"name": "keyword"
		},
		{
			"match": "DEF>",
			"name": "keyword"
		},
		{
			"match": "ESC>",
			"name": "keyword"
		},
		{
			"match": "BLD>",
			"name": "keyword"
		},
		{
			"match": "BOLD>",
			"name": "keyword"
		},
		{
			"match": "ITAL>",
			"name": "keyword"
		},
		{
			"match": "NMPLT",
			"name": "keyword"
		},
		{
			"match": "SPD",
			"name": "keyword"
		},
		{
			"match": "PORT(",
			"name": "keyword"
		},
		{
			"match": "INDNT",
			"name": "keyword"
		},
		{
			"match": "ITAL",
			"name": "keyword.scri.ital"
		},
		{
			"match": "BLD",
			"name": "keyword.bld"
		},
		{
			"match": "BOLD",
			"name": "keyword.bold"
		},
		{
			"match": "IMPORT>",
			"name": "keyword"
		},
		{}
	],
	"scopeName": "source.scri",

	"scope": "source.scri.keyword.ital",
	"settings": {
		"fontStyle": "italic"
	}
}
