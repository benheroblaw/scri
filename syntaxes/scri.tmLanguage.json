{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "scri",
	"patterns": [
		{
			"match": "CMT<.*>",
			"name": "comment.block"
		},
		{
			"match": "CMT>.*",
			"name": "comment.line"
		},
		{
			"match": "[RES|LBLU|LGRN|PUR|BR|BREAK|GRN|PNK|RED|BLU|YLW|LME]>",
			"name": "keyword.other"
		},
		{
			"match": "LBLU>",
			"name": "keyword.other"
		},
		{
			"match": "LGRN>",
			"name": "keyword.other"
		},
		{
			"match": "PUR>",
			"name": "keyword.other"
		},
		{
			"match": "GRN>",
			"name": "keyword.other"
		},
		{
			"match": "PNK>",
			"name": "keyword.other"
		},
		{
			"match": "RED>",
			"name": "keyword.other"
		},
		{
			"match": "BLU>",
			"name": "keyword.other"
		},
		{
			"match": "YLW>",
			"name": "keyword.other"
		},
		{
			"match": "LME>",
			"name": "keyword.other"
		},
		{
			"match": "LGRY>",
			"name": "keyword.other"
		},
		{
			"match": "GRY>",
			"name": "keyword.other"
		},
		{
			"match": "WHI>",
			"name": "keyword.other"
		},
		{
			"match": "DGRY>",
			"name": "keyword.other"
		},
		{
			"match": "CYN>",
			"name": "keyword.other"
		},
		{
			"match": "BLK>",
			"name": "keyword.other"
		},
		{
			"match": "ORN>",
			"name": "keyword.other"
		},
		{
			"match": "BGWHI>",
			"name": "keyword.other"
		},
		{
			"match": "BGRED>",
			"name": "keyword.other"
		},
		{
			"match": "BGBLU>",
			"name": "keyword.other"
		},
		{
			"match": "BGGRN>",
			"name": "keyword.other"
		},
		{
			"match": "BGYLW>",
			"name": "keyword.other"
		},
		{
			"match": "BGPNK>",
			"name": "keyword.other"
		},
		{
			"match": "BGCYN>",
			"name": "keyword.other"
		},
		{
			"match": "BGPUR>",
			"name": "keyword.other"
		},
		{
			"match": "BGLME>",
			"name": "keyword.other"
		},
		{
			"match": "BGGRY>",
			"name": "keyword.other"
		},
		{
			"match": "BGBLK>",
			"name": "keyword.other"
		},
		{
			"match": "BGORN>",
			"name": "keyword.other"
		},
		{
			"match": "NOBR>",
			"name": "keyword.other"
		},
		{
			"match": "CLRA>",
			"name": "keyword.other"
		},
		{
			"match": "CLRB>",
			"name": "keyword.other"
		},
		{
			"match": "CONT>",
			"name": "keyword.other"
		},
		{
			"match": "DEF>",
			"name": "keyword.other"
		},
		{
			"match": "DEF> \\b\\w\\S*\\w,",
			"name": "string"
		},
		{
			"match": "ESC>",
			"name": "keyword.other"
		},
		{
			"match": "NMPLT\\(",
			"name": "keyword.other"
		},
		{
			"match": "NMPLT\\(.*\\)",
			"name": "string"
		},
		{
			"match": "SPD\\(",
			"name": "keyword.other"
		},
		{
			"match": "PORT\\(",
			"name": "keyword.other"
		},
		{
			"match": "INDNT\\(",
			"name": "keyword.other"
		},
		{
			"match": "ITAL[>|(]",
			"name": "keyword.other"
		},
		{
			"match": "BLD[>|(]",
			"name": "keyword.other"
		},
		{
			"match": "BOLD[>|(]",
			"name": "keyword.other"
		},
		{
			"match": "IMPORT>",
			"name": "keyword.other"
		},
		{
			"match": "([\\+\\-])?(\\d+\\.?\\d*|\\.\\d+)([eE][\\-\\+]?\\d+)?",
			"name": "constant.numeric"
		},
		{
			"match": "\\S*\\b:",
			"name": "variable.name"
		},
		{
			"match": "\\b\\w\\S*\\w>",
			"name": "variable.name"
		},
		{}
	],
	"scopeName": "source.scri"
}
